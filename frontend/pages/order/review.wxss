.container { padding: 24rpx; }
.target-name { font-size: 32rpx; font-weight: bold; margin-bottom: 24rpx; }
.form-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.form-item { margin-bottom: 24rpx; }
.form-item .label { display: block; font-size: 28rpx; color: #666; margin-bottom: 12rpx; }
.textarea { width: 100%; min-height: 160rpx; padding: 16rpx; border: 1rpx solid #eee; border-radius: 8rpx; font-size: 28rpx; box-sizing: border-box; }

.upload-section { margin-top: 8rpx; }
.upload-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.upload-item { position: relative; width: 160rpx; height: 160rpx; border-radius: 8rpx; overflow: hidden; }
.upload-item .preview-img { width: 100%; height: 100%; display: block; }
.upload-item .upload-delete { position: absolute; top: 0; right: 0; width: 44rpx; height: 44rpx; background: rgba(0,0,0,.5); color: #fff; font-size: 32rpx; line-height: 44rpx; text-align: center; }
.upload-add { width: 160rpx; height: 160rpx; border: 2rpx dashed #ddd; border-radius: 8rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.upload-add-text { font-size: 48rpx; color: #999; line-height: 1; }
.upload-add-hint { font-size: 24rpx; color: #999; margin-top: 8rpx; }
