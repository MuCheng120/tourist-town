/* pages/order/list.wxss */
.container {
  min-height: 100vh;
  height: auto;
  background-color: #f5f5f5;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom) + 20rpx);
}

.type-filter-scroll {
  width: 100%;
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.type-filter-inner {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
}

.type-chip {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.2;
  color: #666;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
}

.type-chip.active {
  color: #fff;
  background: linear-gradient(135deg, #1989fa 0%, #3a9bff 100%);
}

.order-list {
  padding: 20rpx;
}

.order-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-head-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.order-no {
  font-size: 28rpx;
  color: #333;
  max-width: 430rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-type-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

.order-type-badge.type-food {
  color: #ee0a24;
  background: #fff1f0;
}

.order-type-badge.type-souvenir {
  color: #ed6a0c;
  background: #fff7e8;
}

.order-type-badge.type-scenic {
  color: #1989fa;
  background: #edf6ff;
}

.order-type-badge.type-hotel {
  color: #07c160;
  background: #ecf9f1;
}

.order-type-badge.type-other {
  color: #666;
  background: #f2f3f5;
}

.order-status {
  font-size: 28rpx;
  color: #1989fa;
  font-weight: 500;
}

.order-products {
  padding: 24rpx 32rpx;
}

.product-item {
  display: flex;
  margin-bottom: 24rpx;
}

.product-item:last-child {
  margin-bottom: 0;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.product-spec text {
  margin-right: 16rpx;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.product-price {
  font-size: 32rpx;
  color: #ee0a24;
  font-weight: 500;
}

.product-quantity {
  font-size: 28rpx;
  color: #999;
}

.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-footer-left {
  flex-shrink: 0;
}

.order-detail-link {
  font-size: 26rpx;
  color: #1989fa;
  border: 1rpx solid #1989fa;
  border-radius: 8rpx;
  padding: 8rpx 24rpx;
  line-height: 1.3;
  box-sizing: border-box;
}

.order-actions {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  justify-content: flex-end;
}

.order-actions .van-button {
  flex-shrink: 0;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}
