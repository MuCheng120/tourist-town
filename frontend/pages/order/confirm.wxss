.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.order-item:last-child {
  border-bottom: none;
}
.item-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background: #f0f0f0;
}
.item-info {
  flex: 1;
  min-width: 0;
}
.item-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.item-price {
  font-size: 28rpx;
  color: #ee0a24;
  font-weight: 600;
}
.item-qty {
  font-size: 26rpx;
  color: #999;
}

.address-block {
  padding: 16rpx 0;
}
.address-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.address-phone {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.address-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.address-placeholder {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #999;
}

.delivery-option {
  display: block;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333;
}
.delivery-option radio { margin-right: 12rpx; }

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}
.row .label { color: #666; }
.row .value { color: #333; }
.row.final .value.final-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #ee0a24;
}
.section.total { margin-top: 8rpx; }

.coupon-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.coupon-hint.muted { color: #c8c9cc; }
.coupon-hint .emph { color: #ee0a24; font-weight: 600; }

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  border: 1rpx solid #ffd591;
}
.coupon-text {
  font-size: 28rpx;
  color: #d46b08;
}
.coupon-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.coupon-item {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);
  border-radius: 12rpx;
  border: 1rpx solid #ffd591;
}
.coupon-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ee0a24;
  margin-bottom: 8rpx;
}
.coupon-tag {
  font-size: 22rpx;
  color: #d46b08;
  margin-bottom: 6rpx;
}
.coupon-desc {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}
.coupon-title {
  font-size: 24rpx;
  color: #666;
}
.coupon-empty {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx;
}

.row .value.discount {
  color: #ee0a24;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.final-summary {
  font-size: 32rpx;
  font-weight: bold;
  color: #ee0a24;
}
.submit-btn {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
}
.submit-btn::after { border: none; }
.submit-btn[disabled] { background: #ccc; }
