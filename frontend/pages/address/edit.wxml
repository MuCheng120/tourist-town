<view class="edit-page">
  <van-cell-group>
    <van-field
      value="{{form.userName}}"
      label="收货人"
      placeholder="请输入收货人姓名"
      data-field="userName"
      bind:change="onInput"
    />
    <van-field
      value="{{form.telNumber}}"
      type="number"
      maxlength="11"
      label="手机号"
      placeholder="请输入手机号"
      data-field="telNumber"
      bind:change="onInput"
    />
    <picker mode="region" value="{{regionValue}}" bindchange="onRegionChange">
      <view class="region-picker-row">
        <text class="region-label">所在地区</text>
        <text class="region-text {{regionDisplay ? '' : 'placeholder'}}">{{regionDisplay || '请选择省/市/区'}}</text>
        <van-icon name="arrow" class="region-arrow" />
      </view>
    </picker>
    <van-field
      value="{{form.detailInfo}}"
      label="详细地址"
      placeholder="街道、门牌号等"
      data-field="detailInfo"
      bind:change="onInput"
    />
    <van-field
      value="{{form.postalCode}}"
      label="邮编"
      placeholder="选填"
      data-field="postalCode"
      bind:change="onInput"
    />
  </van-cell-group>
  <view class="submit-wrap">
    <van-button type="primary" block loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">
      {{isEdit ? '保存' : '添加'}}
    </van-button>
  </view>
</view>
