/* pages/address/index.wxss */
.address-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4f8 0%, #f7f8fa 100%);
  padding: 24rpx 24rpx 120rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.header-right {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 8rpx 24rpx;
}

.header-btn {
  font-size: 28rpx;
  color: #1989fa;
  font-weight: 500;
}

.address-list {
  padding: 0 0 24rpx;
}

.address-item {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.address-item--selected {
  background: #f0f9ff;
  border-color: rgba(25, 137, 250, 0.2);
  box-shadow: 0 4rpx 20rpx rgba(25, 137, 250, 0.08);
}

.address-check {
  flex-shrink: 0;
  margin-right: 20rpx;
  padding-top: 6rpx;
}

.address-content {
  flex: 1;
  min-width: 0;
}

.address-header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.phone {
  font-size: 26rpx;
  color: #646566;
  letter-spacing: 0.5rpx;
}

.default-tag {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.address-detail {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.address-detail-icon {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(7, 193, 96, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.detail-text {
  flex: 1;
  font-size: 26rpx;
  color: #646566;
  line-height: 1.65;
  letter-spacing: 0.5rpx;
}

.address-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #1989fa;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.action-btn:active {
  background: rgba(25, 137, 250, 0.08);
}

.action-btn--danger {
  color: #969799;
}

.action-btn--danger:active {
  background: rgba(0, 0, 0, 0.04);
  color: #646566;
}

.action-btn text {
  margin-left: 6rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.1);
  display: flex;
  gap: 20rpx;
}

.add-address-btn {
  flex: 1;
  height: 88rpx;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-address-btn--wechat {
  background-color: #07c160;
}

.add-address-btn--manual {
  background-color: #1989fa;
}

.add-address-btn text {
  margin: 0 8rpx;
}

/* 管理模式底部按钮 */
.manage-btn {
  flex: 1;
  height: 88rpx;
  padding: 0;
  font-size: 28rpx;
  line-height: 1;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.manage-btn--delete {
  background-color: #ee0a24;
  color: #fff;
}

.empty-icon {
  font-size: 120rpx;
  color: #c8c9cc;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #969799;
}
