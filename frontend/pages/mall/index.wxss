/* pages/mall/index.wxss */
/* 覆盖 app.wxss 的 .container：不用固定 height:100vh，否则页面无法随内容增高、划不到底 */
.container {
  box-sizing: border-box;
  display: block;
  height: auto;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* 顶部：仅搜索 + 购物车（整页唯一搜索框） */
.mall-header {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx 24rpx;
  gap: 16rpx;
}
.search-wrap {
  flex: 1;
  min-width: 0;
}
.search-wrap .van-search {
  padding: 0;
}
.search-wrap .van-search__content {
  border-radius: 32rpx;
  background: #f5f5f5;
}
.cart-wrap {
  flex-shrink: 0;
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.cart-badge {
  position: absolute;
  top: 4rpx;
  right: 12rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: #ee0a24;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* 商品类型：特产 / 餐饮（分段选择器；与搜索区拉开间距） */
.segment-wrap {
  background: #fff;
  padding: 16rpx 24rpx 16rpx;
}
.segment-bar {
  display: flex;
  height: 72rpx;
  background: #f0f0f0;
  border-radius: 36rpx;
  padding: 6rpx;
}
.segment-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  border-radius: 30rpx;
  transition: all 0.2s ease;
}
.segment-item.active {
  background: #fff;
  color: #07c160;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 排序条：与分段左右边距对齐，标签在左、按钮在右 */
.sort-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx 16rpx;
  background: #fff;
  border-top: 1rpx solid #f5f5f5;
}
.sort-toolbar-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}
.sort-btns {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}
.sort-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 24rpx;
}
.sort-btn.active {
  color: #07c160;
  background: #e8f8f0;
  font-weight: 500;
}

/* 分类标签 */
.category-tabs {
  background: #fff;
  margin-bottom: 20rpx;
}

/* 商品列表 */
.product-list {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
}

.product-item {
  width: calc(50% - 10rpx);
  margin: 10rpx 5rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.product-image {
  width: 100%;
  height: 320rpx;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
  height: 45rpx;
}

.product-tags {
  margin: 6rpx 0 8rpx;
  display: flex;
  gap: 8rpx;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 32rpx;
  color: #ee0a24;
  font-weight: bold;
}

.product-sales {
  font-size: 22rpx;
  color: #999;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx 0;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 24rpx;
}

/* 商家列表 */
.merchant-list {
  background: #fff;
  margin-top: 20rpx;
}

.merchant-item {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.2s ease;
}

.merchant-item:active {
  background-color: #f5f5f5;
}

.merchant-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.merchant-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.merchant-detail-header {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.merchant-detail-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.merchant-detail-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.merchant-detail-address {
  font-size: 24rpx;
  color: #666;
}

.merchant-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.merchant-description {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-height: 1.4;
}

.merchant-level {
  align-self: flex-start;
}

