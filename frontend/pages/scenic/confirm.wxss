.confirm-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 180rpx;
}

.section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.info-row .label {
  color: #666;
}

.info-row .value {
  color: #333;
}

.total-row .total-value {
  font-size: 36rpx;
  color: #ff6b00;
  font-weight: 600;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.final-summary {
  font-size: 30rpx;
  color: #333;
}

.final-summary .total {
  color: #ff6b00;
  font-weight: 600;
}

.submit-btn {
  background: #1989fa;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}

.submit-btn[disabled] {
  background: #c8c9cc;
}

.coupon-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.coupon-hint .emph {
  color: #ee0a24;
  font-weight: 600;
}
.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  border: 1rpx solid #ffd591;
}
.coupon-text {
  font-size: 28rpx;
  color: #d46b08;
}
.coupon-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.coupon-item {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);
  border-radius: 12rpx;
  border: 1rpx solid #ffd591;
  box-sizing: border-box;
}
.coupon-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ee0a24;
  margin-bottom: 8rpx;
}
.coupon-tag {
  font-size: 22rpx;
  color: #d46b08;
  margin-bottom: 6rpx;
}
.coupon-desc {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}
.coupon-title {
  font-size: 24rpx;
  color: #666;
}
.coupon-empty {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx;
}
.pay-summary .value.discount {
  color: #ee0a24;
}
