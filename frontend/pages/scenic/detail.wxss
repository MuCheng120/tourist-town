.detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.spot-swiper {
  width: 100%;
  height: 500rpx;
}

.spot-image {
  width: 100%;
  height: 100%;
}

.section {
  background: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.basic-info .spot-name-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.basic-info .spot-name {
  flex: 1;
  font-size: 38rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.favorite-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx;
}

.favorite-text {
  font-size: 22rpx;
  color: #666;
}

.rating-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.rating-row .rating-num {
  color: #1989fa;
  font-weight: 600;
}

.rating-row .rating-count {
  color: #333;
}

.operation-section .operation-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.open-status {
  color: #07c160;
  margin-right: 8rpx;
}

.open-time {
  flex: 1;
  color: #666;
}

.contact-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.address-row {
  flex: 1;
  min-width: 0;
}

.address-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.contact-btns {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.contact-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #1989fa;
}

.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  padding: 24rpx 32rpx 20rpx;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #1989fa;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 4rpx;
  background: #1989fa;
  border-radius: 2rpx;
}

.tab-content {
  background: #fff;
  padding: 24rpx 32rpx 40rpx;
}

.book-date-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.book-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 24rpx;
}

.book-value {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

.ticket-list {
  padding: 24rpx 0;
}

.ticket-item {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.ticket-item.selected {
  background: #f0f8ff;
  margin: 0 -32rpx;
  padding: 20rpx 32rpx;
}

.ticket-name {
  font-size: 28rpx;
  color: #333;
  width: 140rpx;
}

.ticket-remark {
  font-size: 24rpx;
  color: #999;
  flex: 1;
  margin: 0 16rpx;
}

.ticket-price {
  font-size: 30rpx;
  color: #ff6b00;
  font-weight: 500;
}

.quantity-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.quantity-label {
  font-size: 28rpx;
  color: #333;
}

.total-row {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  gap: 12rpx;
  padding: 24rpx 0;
}

.total-row-label {
  font-size: 28rpx;
  color: #333;
  line-height: 1;
}

.total-row-amount {
  font-size: 36rpx;
  color: #ff6b00;
  font-weight: 600;
  line-height: 1;
}

.book-submit-btn {
  margin-top: 32rpx;
}

.comment-tab .comment-write-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #1989fa;
}

.comments-list {
  margin-top: 16rpx;
}

.comment-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
}

.comment-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.load-more, .no-more {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: #999;
}

.comment-dialog .dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-dialog .dialog-title {
  font-size: 32rpx;
  font-weight: 600;
}

.comment-dialog .dialog-body {
  padding: 24rpx 32rpx 40rpx;
}

.comment-dialog .score-section {
  margin-bottom: 24rpx;
}

.comment-dialog .score-label {
  margin-right: 16rpx;
  font-size: 28rpx;
}

.submit-comment-btn {
  margin-top: 32rpx;
}

.phone-popup {
  padding: 40rpx 32rpx;
  min-width: 400rpx;
}

.phone-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.phone-popup-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.phone-number {
  font-size: 36rpx;
  color: #1989fa;
  font-weight: 500;
}

.phone-empty {
  font-size: 28rpx;
  color: #999;
}

.phone-popup-close {
  margin-top: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1989fa;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.replies {
  margin-top: 24rpx;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
}

.reply-item {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.reply-content {
  flex: 1;
}

.reply-header {
  margin-bottom: 6rpx;
}

.reply-name {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.reply-to {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.reply-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.load-more,
.no-more {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.empty-comments {
  padding: 120rpx 0;
}

.comment-dialog {
  padding: 32rpx;
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.dialog-body {
  padding-bottom: 32rpx;
}

.score-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.score-label {
  font-size: 28rpx;
  color: #666;
}

.dialog-footer {
  margin-top: 32rpx;
}

/* 地图预览 */
.map-row {
  flex-direction: column;
  align-items: flex-start;
}

.map-preview {
  width: 100%;
  height: 300rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
  margin-top: 16rpx;
}

.mini-map {
  width: 100%;
  height: 100%;
}

.map-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  padding: 40rpx 20rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #fff;
  font-size: 28rpx;
}

/* 底部预订栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}

.price-info {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 24rpx;
  color: #999;
}

.price-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ee0a24;
}

.book-btn {
  width: 400rpx !important;
}

/* 预订弹窗 */
.book-dialog {
  padding: 32rpx;
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.dialog-body {
  padding-bottom: 32rpx;
}

.book-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.book-spot-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.book-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ee0a24;
}

.date-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.date-label {
  font-size: 28rpx;
  color: #666;
}

.date-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.dialog-footer {
  margin-top: 32rpx;
}
