.scenic-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

/* 搜索框：浅灰圆角，与参考图一致 */
.search-wrap {
  margin-bottom: 16rpx;
}
.search-wrap .van-search {
  padding: 0;
}
.search-wrap .van-search__content {
  border-radius: 32rpx;
  background: #f5f5f5;
  border: 1rpx solid #e5e5e5;
}

/* 筛选栏：横向标签，与酒店页一致 */
.filter-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  background: #fff;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  gap: 16rpx;
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.filter-item {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #666;
  border-radius: 24rpx;
  background: #f5f5f5;
}

.filter-item.active {
  color: #fff;
  background: #1989fa;
}

.spot-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 卡片：左侧封面图，右侧信息 */
.spot-card {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.spot-cover-wrap {
  position: relative;
  flex-shrink: 0;
  width: 220rpx;
  height: 220rpx;
}

.spot-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.spot-distance {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.spot-body {
  flex: 1;
  min-width: 0;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.spot-name-row {
  margin-bottom: 8rpx;
}

.spot-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.spot-rating-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 6rpx;
}

.spot-rating-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #1989fa;
}

.spot-rating-max {
  font-size: 22rpx;
  color: #999;
}

.spot-review-count {
  font-size: 22rpx;
  color: #333;
  margin-left: 8rpx;
}

.spot-location-row {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spot-tags-price-row {
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: auto;
}

.spot-tags {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* 景点标签：青绿系，与自然景区气质一致，与评分蓝、价格橙区分 */
.spot-tag {
  font-size: 22rpx;
  font-weight: 500;
  color: #0d9488;
  padding: 6rpx 14rpx;
  border: none;
  border-radius: 8rpx;
  background: #ccfbf1;
  line-height: 1.3;
}

.spot-price-wrap {
  flex-shrink: 0;
  text-align: right;
}

.spot-price-label {
  font-size: 22rpx;
  color: #333;
}

.spot-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff6b00;
  margin-left: 4rpx;
}

.loading-more,
.no-more {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.empty {
  padding: 200rpx 0;
}
