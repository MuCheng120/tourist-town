<view class="register-container">
  <view class="header">
    <text class="title">用户注册</text>
    <text class="subtitle">欢迎加入旅游小镇</text>
  </view>

  <view class="form-card">
  <van-cell-group>
    <van-field
      value="{{ username }}"
      label="用户名"
      placeholder="请输入用户名"
      bind:change="onUsernameChange"
      required
      clearable
    />
    
    <van-field
      value="{{ phone }}"
      label="手机号"
      placeholder="请输入手机号"
      bind:change="onPhoneChange"
      required
      clearable
      type="number"
    />

    <van-field
      label="用户身份"
      required
      custom-class="field-with-radios"
    >
      <van-radio-group
        slot="input"
        value="{{ role }}"
        bind:change="onRoleChange"
        direction="horizontal"
        class="field-radio-group"
      >
        <van-radio name="consumer" checked-color="#07c160">游客</van-radio>
        <van-radio name="merchant" checked-color="#1989fa">商家</van-radio>
      </van-radio-group>
    </van-field>

    <!-- 仅在选择商家身份时展示商家资料字段 -->
    <block wx:if="{{ role === 'merchant' }}">
      <van-field
        value="{{ businessName }}"
        label="商家名称"
        placeholder="请输入商家名称"
        bind:change="onBusinessNameChange"
        required
        clearable
      />
      <van-field
        value="{{ contact }}"
        label="联系方式"
        placeholder="请输入手机号或微信号"
        bind:change="onContactChange"
        required
        clearable
      />

      <van-field
        value="{{ licenseNo }}"
        label="营业执照号（选填）"
        placeholder="营业执照号或统一社会信用代码"
        bind:change="onLicenseNoChange"
        clearable
        required="{{ false }}"
      />

      <picker mode="date" value="{{ licenseExpiry }}" bindchange="onLicenseExpiryChange">
        <van-field
          value="{{ licenseExpiry }}"
          label="执照到期（选填）"
          placeholder="请选择到期日期"
          readonly
          required="{{ false }}"
        />
      </picker>

      <van-field label="营业执照照片" required custom-class="field-with-uploader">
        <van-uploader
          slot="input"
          file-list="{{ licenseFileList }}"
          max-count="1"
          upload-icon="plus"
          upload-text="上传"
          bind:after-read="onLicenseAfterRead"
          bind:delete="onLicenseDelete"
        />
      </van-field>

      <van-field label="资质文件" required custom-class="field-with-uploader">
        <van-uploader
          slot="input"
          accept="file"
          extension="{{ qualificationFileExtension }}"
          file-list="{{ qualificationFileList }}"
          max-count="3"
          upload-icon="plus"
          upload-text="上传资质文件"
          bind:after-read="onQualificationAfterRead"
          bind:delete="onQualificationDelete"
        />
      </van-field>

      <van-field label="身份证正面" required custom-class="field-with-uploader">
        <van-uploader
          slot="input"
          file-list="{{ idCardFrontFileList }}"
          max-count="1"
          upload-icon="plus"
          upload-text="上传正面"
          bind:after-read="onIdCardFrontAfterRead"
          bind:delete="onIdCardFrontDelete"
        />
      </van-field>
      <van-field label="身份证反面" required custom-class="field-with-uploader">
        <van-uploader
          slot="input"
          file-list="{{ idCardBackFileList }}"
          max-count="1"
          upload-icon="plus"
          upload-text="上传反面"
          bind:after-read="onIdCardBackAfterRead"
          bind:delete="onIdCardBackDelete"
        />
      </van-field>

      <van-field
        value="{{ merchantAddress }}"
        label="经营地址（选填）"
        placeholder="请输入门店/经营地址"
        bind:change="onMerchantAddressChange"
        clearable
        required="{{ false }}"
      />

      <van-field
        value="{{ merchantDesc }}"
        label="商家简介"
        placeholder="简单介绍一下主营业务、营业时间等"
        type="textarea"
        autosize
        bind:change="onMerchantDescChange"
        maxlength="300"
        show-word-limit
        custom-class="field-textarea"
      />
    </block>

    <van-field
      label="性别"
      required
      custom-class="field-with-radios"
    >
      <van-radio-group
        slot="input"
        value="{{ gender }}"
        bind:change="onGenderChange"
        direction="horizontal"
        class="field-radio-group"
      >
        <van-radio name="male" checked-color="#07c160">男</van-radio>
        <van-radio name="female" checked-color="#07c160">女</van-radio>
      </van-radio-group>
    </van-field>

    <van-field
      value="{{ password }}"
      label="密码"
      placeholder="8-20位，须含字母、数字和特殊符号"
      bind:change="onPasswordChange"
      required
      password
      clearable
    />

    <van-field
      value="{{ confirmPassword }}"
      label="确认密码"
      placeholder="请再次输入密码"
      bind:change="onConfirmPasswordChange"
      required
      password
      clearable
    />
  </van-cell-group>
  </view>

  <!-- 密码一致性提示 -->
  <view wx:if="{{ confirmPassword.length > 0 && password !== confirmPassword }}" class="error-tip">
    <van-icon name="warning-o" color="#ee0a24" />
    <text>两次输入的密码不一致</text>
  </view>

  <!-- 用户名重复提示 -->
  <view wx:if="{{ !isUsernameUnique }}" class="error-tip">
    <van-icon name="warning-o" color="#ee0a24" />
    <text>该用户名已被注册</text>
  </view>

  <view class="button-group">
    <van-button 
      type="primary" 
      block 
      bind:click="handleRegister"
      disabled="{{ !canSubmit }}"
      loading="{{ loading }}"
    >
      注册
    </van-button>
  </view>

  <view class="footer">
    <text>已有账号？</text>
    <text class="link" bind:tap="goToLogin">立即登录</text>
  </view>

</view>
