/* 房型详情页 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.gallery-wrap {
  position: relative;
  width: 100%;
  height: 420rpx;
  background: #e8e8e8;
}

.gallery-swipe {
  height: 100%;
}

.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

.gallery-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-indicator {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 20rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 24rpx;
  border-radius: 20rpx;
}

.section {
  background: #fff;
  margin-top: 16rpx;
  padding: 28rpx 24rpx;
}

.name-section {
  padding-bottom: 24rpx;
}

.room-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
}

.spec-section {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.spec-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 32rpx;
}

.spec-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.section-head.main {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.section-desc.extra-bed {
  color: #969799;
  font-size: 24rpx;
}

.breakfast-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-line {
  font-size: 26rpx;
  color: #666;
}

.toiletries-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.toiletry-item {
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.features-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.policy-section {
  padding-bottom: 32rpx;
}

.policy-block {
  margin-bottom: 24rpx;
}

.policy-block:last-child {
  margin-bottom: 0;
}

.policy-subhead {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.policy-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: block;
}

.policy-text.muted {
  color: #969799;
}

.bottom-placeholder {
  height: 40rpx;
}

.page-loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

/* 底部预订栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.price-wrap {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 40rpx;
  font-weight: bold;
  color: #ee0a24;
}

.price-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
}

.bottom-bar .book-btn {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx 64rpx;
  font-size: 30rpx;
}

.bottom-bar .book-btn::after {
  border: none;
}

.bottom-bar .book-btn[disabled] {
  background: #ccc;
}
