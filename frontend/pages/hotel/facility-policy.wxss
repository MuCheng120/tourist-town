.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #666;
}

.tab.active {
  color: #1989fa;
  font-weight: 600;
  position: relative;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 56rpx;
  height: 6rpx;
  transform: translateX(-50%);
  background: #1989fa;
  border-radius: 6rpx;
}

.content {
  height: calc(100vh - 88rpx);
}

.section {
  padding: 20rpx 24rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin: 16rpx 0;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.desc {
  font-size: 26rpx;
  color: #333;
  line-height: 1.7;
  white-space: pre-wrap;
}

.muted {
  color: #969799;
}

.tag-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx 16rpx;
}

.tag-item {
  padding: 14rpx 12rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  min-width: 0;
}

.tag-item-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.tag-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tag-text-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.35;
  word-break: break-all;
}

.tag-desc {
  font-size: 22rpx;
  color: #969799;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.policy-section {
  margin-bottom: 18rpx;
}

.policy-section:last-child {
  margin-bottom: 0;
}

.policy-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.policy-item {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
}

.policy-rich {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
}

