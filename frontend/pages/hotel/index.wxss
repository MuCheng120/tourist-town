/* pages/hotel/index.wxss - 顶部搜索框样式，左侧条件+右侧搜索 */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  height: auto;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom) + 20rpx);
}

/* 顶部：一体式浅灰圆角条（按参考图） */
.search-header-wrap {
  padding: 24rpx 24rpx 20rpx;
  background: #f5f5f5;
}

.search-header {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  background: #f0f0f0;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.search-header-left {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-right: 24rpx;
}

.search-header-loc {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.3;
  display: block;
  margin-bottom: 6rpx;
}

.search-header-meta {
  font-size: 24rpx;
  color: #333;
  line-height: 1.4;
}

.search-header-divider {
  width: 1rpx;
  height: 56rpx;
  background: #e0e0e0;
  flex-shrink: 0;
}

.search-header-right {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.search-header-right .van-search {
  padding: 0;
}

.search-header-right .van-search__content {
  background: transparent !important;
  border-radius: 0;
}

/* 弹窗1：条件选择（无顶部重复信息），底部留出 TabBar 高度避免按钮被遮挡 */
.criteria-popup {
  padding: 24rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
}

.criteria-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.criteria-row-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}

.criteria-row-value {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  text-align: right;
  margin-right: 12rpx;
}

.criteria-popup-footer {
  margin-top: 32rpx;
}

/* 筛选栏：四个排序项平铺 */
.filter-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  background: #fff;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  gap: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.filter-item {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #666;
  border-radius: 24rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.filter-item.active {
  color: #fff;
  background: #1989fa;
}

.filter-arrow {
  font-size: 24rpx;
  line-height: 1;
}

.hotel-list {
  padding: 0 24rpx;
}

.hotel-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  display: flex;
  align-items: stretch;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.hotel-cover {
  width: 180rpx;
  height: auto;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background: #f0f0f0;
  flex-shrink: 0;
  align-self: stretch;
}

.hotel-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
}

.hotel-body {
  flex: 1;
  min-width: 0;
}

.hotel-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.hotel-stats {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
}

.hotel-rating {
  color: #1989fa;
  font-weight: bold;
  margin-right: 4rpx;
}

.hotel-sep {
  color: #c8c9cc;
}

.hotel-comment-count,
.hotel-favorite-count {
  color: #969799;
}

.hotel-address-row {
  margin-bottom: 6rpx;
}

.hotel-distance {
  font-size: 24rpx;
  color: #1989fa;
  margin-right: 12rpx;
}

.hotel-address {
  font-size: 24rpx;
  color: #969799;
  display: block;
}

.hotel-intro {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.hotel-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.hotel-tag {
  font-size: 22rpx;
  color: #1989fa;
  border: 1rpx solid #1989fa;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #fff;
}

.hotel-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx;
}

.hotel-price-wrap {
  flex-shrink: 0;
}

.hotel-min-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b00;
}

.hotel-stock-tip {
  font-size: 22rpx;
  color: #ee0a24;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}
