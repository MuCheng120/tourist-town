.footprint-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.footprint-list {
  padding: 20rpx;
}

.footprint-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background-color: #f0f0f0;
}

.item-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-info {
  flex: 1;
  margin-left: 24rpx;
  margin-right: 16rpx;
}

.item-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.item-type {
  display: inline-block;
  padding: 4rpx 16rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  margin-right: 16rpx;
  color: #666;
}

.item-time {
  flex: 1;
}

.arrow-icon {
  color: #ccc;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #bbb;
}

.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #bbb;
  font-size: 28rpx;
}
