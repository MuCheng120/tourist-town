.container { padding: 24rpx; min-height: 100vh; }
.tabs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
  background: #f8f9fa;
  border: 1rpx solid #e8ebe9;
  border-radius: 12rpx;
  height: 72rpx;
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 18rpx 0;
  border-radius: 8rpx;
  border: 1rpx solid transparent;
  transition: all 0.2s ease;
}
.tab.active {
  color: #07c160;
  font-weight: 500;
  background: #fff;
  border: 1rpx solid #07c160;
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.12);
}
.card { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 24rpx; }
.cover { width: 160rpx; height: 120rpx; border-radius: 12rpx; margin-right: 24rpx; }
.cover.placeholder { background: #f0f0f0; justify-content: center; align-items: center; display: flex; }
.body { flex: 1; min-width: 0; }
.name { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }
.intro { font-size: 24rpx; color: #666; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.arrow { color: #c8c9cc; }
.loading { display: flex; justify-content: center; padding: 40rpx; }
