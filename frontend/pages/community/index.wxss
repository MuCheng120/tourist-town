/* pages/community/index.wxss */
/* 覆盖 app.wxss 全局 .container 的 height:100vh，避免整页高度锁死在视口内、列表底部被自定义 tabBar 挡住 */
.container {
  box-sizing: border-box;
  width: 100%;
  background-color: #f5f5f5;
  min-height: 100vh;
  height: auto;
  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 搜索栏 */
.search-bar {
  background: #fff;
  padding: 20rpx;
}

/* 分类标签 */
.category-tabs {
  background: #fff;
  border-bottom: 1px solid #f0f0f0;
}

.tabs-scroll {
  white-space: nowrap;
  padding: 20rpx;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 20rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
}

.tab-item.active {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
}

/* 攻略列表 */
.post-list {
  padding: 20rpx;
}

.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.author-info {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.author-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
}

.author-details {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.post-time {
  font-size: 22rpx;
  color: #999;
}

.post-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  display: block;
  margin-bottom: 20rpx;
}

/* 图片预览 */
.post-images {
  margin-bottom: 20rpx;
}

.post-image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  position: relative;
}

.grid-image {
  width: 100%;
  height: 200rpx;
  border-radius: 8rpx;
}

.image-mask {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: calc(100% / 3 - 8rpx);
  height: 200rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.post-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 20rpx;
}

/* 互动数据 */
.post-stats {
  display: flex;
  gap: 40rpx;
  padding-top: 20rpx;
  border-top: 1px solid #f0f0f0;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

/* 发布按钮：抬高以免被底部 tabBar 遮挡 */
.publish-btn {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.4);
  z-index: 999;
}
