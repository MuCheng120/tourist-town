/* pages/community/detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.post-header {
  background-color: #fff;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.post-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.post-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.author-info {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.author-name {
  font-size: 28rpx;
  color: #666;
}

.post-time {
  font-size: 24rpx;
  color: #999;
}

.post-content {
  background-color: #fff;
  padding: 32rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
}

.post-images {
  background-color: #fff;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.post-image {
  width: calc((100% - 32rpx) / 3);
  border-radius: 8rpx;
}

.post-stats {
  background-color: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  gap: 48rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-text {
  font-size: 28rpx;
  color: #666;
}

.comments-section {
  background-color: #fff;
  padding: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 32rpx;
}

.comments-list {
  margin-bottom: 32rpx;
}

.comment-item {
  display: flex;
  margin-bottom: 32rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

/* 多级评论缩进 */
.comment-item-depth-1 { padding-left: 32rpx; border-left: 4rpx solid #eee; }
.comment-item-depth-2 { padding-left: 64rpx; border-left: 4rpx solid #eee; }
.comment-item-depth-3 { padding-left: 96rpx; border-left: 4rpx solid #eee; }
.comment-item-depth-4 { padding-left: 128rpx; border-left: 4rpx solid #eee; }
.comment-item-depth-5 { padding-left: 160rpx; border-left: 4rpx solid #eee; }

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-author {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.comment-like {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.like-count {
  font-size: 24rpx;
  color: #999;
}

.reply-to {
  margin-bottom: 8rpx;
}

.reply-text {
  font-size: 24rpx;
  color: #1989fa;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.comment-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
}

.comment-reply {
  font-size: 24rpx;
  color: #1989fa;
}

.comment-text-wrap {
  padding: 4rpx 0;
}

.sub-comments {
  margin-top: 16rpx;
  padding: 0;
  background-color: transparent;
  border-radius: 0;
}

/* 所有级别评论都不缩进 */
.sub-comments .sub-comments {
  margin-top: 16rpx;
  padding: 0;
  background-color: transparent;
  border-radius: 0;
}

.sub-comment-item {
  display: flex;
  margin-bottom: 16rpx;
}

.sub-comment-item:last-child {
  margin-bottom: 0;
}

.sub-comment-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.sub-comment-content {
  flex: 1;
}

.sub-comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.sub-comment-author {
  font-size: 24rpx;
  color: #666;
  margin-right: 8rpx;
}

.sub-comment-actions {
  display: flex;
  align-items: center;
}

.sub-comment-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.sub-comment-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.comment-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 16rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 发送评论按钮：缩小宽度与字号 */
.comment-submit-btn {
  flex-shrink: 0;
  min-width: 0 !important;
  width: 160rpx !important;
  max-width: 160rpx !important;
  font-size: 24rpx !important;
  padding: 0 12rpx !important;
  height: 56rpx !important;
  line-height: 56rpx !important;
  box-sizing: border-box !important;
}

/* 加载更多和没有更多的样式 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0;
}

.no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0;
  color: #999;
  font-size: 24rpx;
}

/* 展开/折叠按钮样式 */
.comment-expand-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16rpx 0;
  margin-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.comment-expand-btn text {
  font-size: 22rpx;
  color: #1989fa;
}
