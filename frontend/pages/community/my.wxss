/* pages/community/my.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.posts-list {
  padding: 20rpx;
}

.post-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.post-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.post-content {
  margin-bottom: 16rpx;
}

.post-desc {
  font-size: 28rpx;
  color: #646566;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

.post-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

.post-stats {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #ebedf0;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #969799;
}

.post-time {
  margin-left: auto;
  font-size: 24rpx;
  color: #969799;
}

.post-actions {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.post-actions .van-button {
  max-width: 330rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.post-actions .van-button:nth-child(1) {
  background: #f5f7ff;
  border: none;
  color: #1989fa;
}

.post-actions .van-button:nth-child(2) {
  background: #fff1f0;
  border: none;
  color: #ee0a24;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.bottom-btn {
  margin-top: 40rpx;
}
