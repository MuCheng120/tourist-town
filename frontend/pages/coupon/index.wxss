/* 用户端 - 我的优惠券样式 */
.coupon-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 标签栏 */
.tabs {
  display: flex;
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff6b6b;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #ff6b6b;
  border-radius: 2rpx;
}

/* 优惠券列表 */
.coupon-list {
  padding: 20rpx;
}

.coupon-item {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8787 100%);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.2);
}

.coupon-main {
  display: flex;
  padding: 32rpx;
  background-color: #fff;
  position: relative;
}

/* 虚线分割 */
.coupon-main::after {
  content: '';
  position: absolute;
  right: 220rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  border-left: 2rpx dashed #ddd;
}

/* 左侧金额区 */
.coupon-left {
  flex: 0 0 180rpx;
  text-align: center;
  padding-right: 20rpx;
}

.amount {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  margin-bottom: 8rpx;
}

.currency {
  font-size: 32rpx;
  color: #ff6b6b;
  font-weight: bold;
  margin-top: 8rpx;
}

.value {
  font-size: 72rpx;
  color: #ff6b6b;
  font-weight: bold;
  line-height: 1;
}

.condition {
  font-size: 22rpx;
  color: #999;
}

/* 右侧信息区 */
.coupon-right {
  flex: 1;
  padding-left: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background-color: #fff7e6;
  color: #fa8c16;
  border-radius: 4rpx;
  font-size: 22rpx;
  margin-bottom: 12rpx;
  width: fit-content;
}

.expire-date {
  font-size: 24rpx;
  color: #999;
}

/* 优惠券底部 */
.coupon-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
  background-color: #fffaf0;
}

.use-btn {
  padding: 12rpx 32rpx;
  background-color: #ff6b6b;
  color: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  border: none;
  line-height: 1.5;
}

.detail-link {
  font-size: 24rpx;
  color: #999;
  text-decoration: underline;
}

.used-tag {
  padding: 8rpx 24rpx;
  background-color: #f5f5f5;
  color: #999;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.expired-tag {
  padding: 8rpx 24rpx;
  background-color: #f5f5f5;
  color: #999;
  border-radius: 40rpx;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.go-mall-btn {
  padding: 16rpx 48rpx;
  background-color: #ff6b6b;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
