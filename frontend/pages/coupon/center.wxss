/* 领券中心 */
.center-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 32rpx;
}

.header-tip {
  background: #fff7e6;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.link-btn {
  font-size: 26rpx;
  color: #ff6b6b;
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  line-height: 1.5;
}

.link-btn::after {
  border: none;
}

.center-tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.center-tabs .tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
}

.center-tabs .tab-item.active {
  color: #ee0a24;
  font-weight: bold;
  border-bottom: 4rpx solid #ee0a24;
}

.coupon-right .shop-name {
  color: #1989fa;
  font-size: 24rpx;
}

.coupon-list {
  padding: 24rpx;
}

.coupon-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.coupon-main {
  display: flex;
  padding: 32rpx;
  position: relative;
}

.coupon-main::after {
  content: '';
  position: absolute;
  right: 220rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  border-left: 2rpx dashed #eee;
}

.coupon-left {
  flex: 0 0 180rpx;
  text-align: center;
  padding-right: 20rpx;
}

.amount {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  margin-bottom: 8rpx;
}

.currency {
  font-size: 32rpx;
  color: #ff6b6b;
  font-weight: bold;
  margin-top: 8rpx;
}

.value {
  font-size: 72rpx;
  color: #ff6b6b;
  font-weight: bold;
  line-height: 1;
}

.condition {
  font-size: 22rpx;
  color: #999;
}

.coupon-right {
  flex: 1;
  padding-left: 32rpx;
}

.coupon-right .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.coupon-right .meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.coupon-footer {
  padding: 20rpx 32rpx;
  background: #fffaf0;
  display: flex;
  justify-content: flex-end;
}

.receive-btn {
  padding: 14rpx 40rpx;
  background: #ff6b6b;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
  line-height: 1.4;
}

.receive-btn.received {
  background: #e0e0e0;
  color: #999;
}

.receive-btn[disabled] {
  color: #999;
}

.empty-state,
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}
