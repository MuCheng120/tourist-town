/* 商家端 - 优惠券管理样式 */
.coupon-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 操作栏 */
.action-bar {
  padding: 20rpx;
}

.create-btn {
  width: 100%;
  background-color: #52c41a;
  color: #fff;
  border-radius: 8rpx;
}

/* 优惠券列表 */
.coupon-list {
  padding: 0 20rpx;
}

.coupon-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.coupon-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.coupon-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.coupon-status {
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.coupon-status.active {
  background-color: #f6ffed;
  color: #52c41a;
}

.coupon-status.inactive {
  background-color: #f5f5f5;
  color: #999;
}

.coupon-info {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-row .label {
  color: #999;
  margin-right: 8rpx;
}

.info-row .value {
  color: #333;
}

.info-row .value.highlight {
  color: #ff4d4f;
  font-weight: bold;
  font-size: 28rpx;
}

.coupon-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.action-btn {
  flex: 0 0 auto;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  background-color: #f0f0f0;
  color: #666;
  border: none;
}

.action-btn.detail {
  background-color: #e6f7ff;
  color: #1890ff;
}

.action-btn.warning {
  background-color: #fff7e6;
  color: #fa8c16;
}

.action-btn.success {
  background-color: #f6ffed;
  color: #52c41a;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.create-empty-btn {
  padding: 16rpx 48rpx;
  background-color: #52c41a;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  box-sizing: border-box;
  width: 640rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  cursor: pointer;
}

.modal-body {
  box-sizing: border-box;
  padding: 32rpx;
  max-height: 800rpx;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.form-input {
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  background-color: #fff;
}

.picker {
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  background-color: #fff;
}

.tips {
  margin-top: 32rpx;
  padding: 24rpx;
  background-color: #fffbe6;
  border-radius: 8rpx;
  border-left: 4rpx solid #faad14;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #fa8c16;
  margin-bottom: 12rpx;
}

.tips-text {
  display: block;
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.tips-text:last-child {
  margin-bottom: 0;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-footer .modal-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  border: none;
  border-radius: 0;
  margin: 0;
  padding: 0;
}

.modal-footer .modal-btn.cancel {
  background-color: #fff;
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.modal-footer .modal-btn.confirm {
  background-color: #52c41a;
  color: #fff;
}
