/* merchant/pages/orders/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 标签栏 */
.tabs {
  display: flex;
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #1989fa;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #1989fa;
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
}

.order-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 26rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.order-status.status-pending {
  background-color: #fff3e0;
  color: #ff9800;
}

.order-status.status-paid {
  background-color: #e3f2fd;
  color: #2196f3;
}

.order-status.status-shipped {
  background-color: #f3e5f5;
  color: #9c27b0;
}

.order-status.status-completed {
  background-color: #e8f5e9;
  color: #4caf50;
}

/* 商品信息 */
.product-info {
  display: flex;
  padding: 24rpx 0;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.product-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-spec {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.product-price {
  font-size: 32rpx;
  color: #ff6034;
  font-weight: bold;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-name {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  margin-left: 8rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
}

.order-amount {
  font-size: 34rpx;
  color: #ff6034;
  font-weight: bold;
}

.action-btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  border-radius: 40rpx;
  background-color: #fff;
  border: 1rpx solid #ddd;
  color: #666;
  margin-left: 16rpx;
}

.ship-btn {
  background-color: #1989fa;
  border-color: #1989fa;
  color: #fff;
}

.danger-btn {
  background-color: #07c160;
  border-color: #07c160;
  color: #fff;
}

.refund-pending-text {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #ff976a;
}

/* 加载状态 */
.loading, .no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}
