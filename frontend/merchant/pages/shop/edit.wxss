.shop-edit-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.form-section {
  margin-bottom: 24rpx;
  background: #fff;
}

.section-title {
  padding: 24rpx 32rpx 16rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #323233;
}

.address-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 16rpx 32rpx 24rpx;
}

.images-tip {
  padding: 0 32rpx 16rpx;
  font-size: 24rpx;
  color: #969799;
}

.images-row {
  display: flex;
  flex-wrap: wrap;
  padding: 0 32rpx 32rpx;
  gap: 20rpx;
}

.img-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.img-wrap .thumb {
  width: 100%;
  height: 100%;
}

.img-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  background: rgba(0,0,0,0.5);
  border-radius: 0 8rpx 0 8rpx;
}

.img-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #dcdee0;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.img-add .icon {
  font-size: 48rpx;
  color: #969799;
  line-height: 1;
}

.img-add .text {
  font-size: 24rpx;
  color: #969799;
  margin-top: 8rpx;
}

.submit-wrap {
  margin: 40rpx 30rpx 0;
}
