/* merchant/pages/ship/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

/* 订单信息 */
.order-info {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-item {
  display: flex;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-item .label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.info-item .value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

/* 不可发货时的提示 */
.status-tip {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background-color: #fff1f0;
  border-radius: 12rpx;
  border-left: 4rpx solid #ee0a24;
}

.status-tip .tip-text {
  flex: 1;
  font-size: 28rpx;
  color: #ee0a24;
  line-height: 1.6;
  margin-left: 12rpx;
}

/* 发货表单 */
.ship-form {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-text {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.required {
  color: #ff6034;
  margin-left: 4rpx;
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-value.placeholder {
  color: #999;
}

.input-wrapper {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #f7f8fa;
  border-radius: 12rpx;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.scan-btn {
  padding: 8rpx 16rpx;
  margin-left: 16rpx;
  background-color: #e3f2fd;
  border-radius: 8rpx;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1989fa 0%, #1a7fd8 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  margin-top: 40rpx;
}

.submit-btn[disabled] {
  background: #ccc;
}

/* 温馨提示 */
.tips {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-top: 40rpx;
  background-color: #fffbe8;
  border-radius: 12rpx;
  border-left: 4rpx solid #ff9800;
}

.tips-text {
  flex: 1;
  font-size: 26rpx;
  color: #f57c00;
  line-height: 1.6;
  margin-left: 8rpx;
}
