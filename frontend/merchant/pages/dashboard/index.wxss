/* merchant/pages/dashboard/index.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 店铺状态条 */
.merchant-status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}
.merchant-status-bar .status-label {
  font-size: 28rpx;
  color: #666;
}
.merchant-status-bar .status-value {
  font-size: 28rpx;
  font-weight: bold;
}
.merchant-status-bar .status-approved {
  color: #07c160;
}
.merchant-status-bar .status-pending {
  color: #ff976a;
}
.merchant-status-bar .status-rejected {
  color: #ee0a24;
}

/* 时间范围切换 */
.time-range-selector {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.time-option {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.time-option.active {
  color: #07c160;
  font-weight: bold;
}

.time-option.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background: #07c160;
  border-radius: 2rpx;
}

/* 统计卡片 */
.stats-section {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.stat-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  border-radius: 16rpx;
}

.stat-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 50%;
  margin-right: 16rpx;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #666;
}

/* 快捷操作 */
.quick-actions {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.action-item text {
  font-size: 24rpx;
  color: #666;
  margin-top: 12rpx;
}

/* 待发货订单 */
.pending-section {
  background: #fff;
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.more-btn {
  font-size: 26rpx;
  color: #07c160;
}

.order-card {
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.order-time {
  font-size: 22rpx;
  color: #999;
}

.product-info {
  display: flex;
  margin-bottom: 16rpx;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.product-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  line-height: 1.4;
}

.product-quantity {
  font-size: 24rpx;
  color: #999;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1px solid #e8e8e8;
}

.order-amount {
  font-size: 32rpx;
  color: #ee0a24;
  font-weight: bold;
}

.ship-btn {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
}

.ship-btn::after {
  border: none;
}

.empty-wrap {
  padding: 60rpx 0;
  background: #fff;
}

/* 退出登录 */
.logout-section {
  margin: 40rpx 20rpx;
}

.logout-btn {
  background: #fff;
  color: #ee0a24;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 30rpx;
}

.logout-btn::after {
  border: none;
}
