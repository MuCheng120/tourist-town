/* merchant/pages/verify/index.wxss */
.verify-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.scan-area {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.scan-icon {
  margin-bottom: 30rpx;
}

.scan-tip {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.actions {
  margin-bottom: 40rpx;
}

.button-center {
  display: flex;
  justify-content: center;
}

.result-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.result-card.success {
  border: 2rpx solid #07c160;
}

.result-card.error {
  border: 2rpx solid #ee0a24;
}

.result-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin: 30rpx 0;
}

.result-card.success .result-title {
  color: #07c160;
}

.result-card.error .result-title {
  color: #ee0a24;
}

.result-info {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.info-label {
  color: #666;
  margin-right: 8rpx;
}

.info-value {
  color: #333;
  font-weight: 500;
}

.manual-input {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.manual-button-wrap {
  margin-top: 20rpx;
}
