.credit-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 信用等级卡片 */
.credit-card {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.level-badge {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.level-text {
  font-size: 72rpx;
  font-weight: bold;
  color: white;
}

.credit-info {
  width: 100%;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.score {
  font-size: 48rpx;
  font-weight: bold;
  color: #1989fa;
}

.rate {
  font-size: 32rpx;
  font-weight: bold;
  color: #07c160;
}

.time {
  font-size: 26rpx;
  color: #999;
}

.level-desc {
  width: 100%;
  background: #f7f8fa;
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.btn-refresh,
.btn-desc {
  flex: 1;
  height: 80rpx;
  line-height: 1;
  padding: 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-refresh {
  background: #1989fa;
  color: white;
}

.btn-desc {
  background: white;
  color: #1989fa;
  border: 1rpx solid #1989fa;
}

/* 小程序 button 默认有内边距，需重置以保证文字居中 */
.btn-refresh::after,
.btn-desc::after {
  border: none;
}

/* 违规记录 */
.violations-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.violation-item {
  padding: 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.violation-item:last-child {
  margin-bottom: 0;
}

.violation-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.violation-type {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.violation-type.warning {
  background: #fff7e6;
  color: #fa8c16;
}

.violation-type.limit {
  background: #e6f7ff;
  color: #1890ff;
}

.violation-type.suspend {
  background: #fff1f0;
  color: #f5222d;
}

.violation-type.revoke {
  background: #f5f5f5;
  color: #999;
}

.violation-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.violation-status.active {
  background: #fff1f0;
  color: #f5222d;
}

.violation-status.resolved {
  background: #f6ffed;
  color: #52c41a;
}

.violation-reason {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.violation-time {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-state text {
  display: block;
  font-size: 28rpx;
  color: #999;
}
