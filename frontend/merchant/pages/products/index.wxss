.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}
.action-bar {
  padding: 24rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.btn-publish {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
}
.btn-publish:active {
  opacity: 0.92;
}

.list {
  padding: 0 20rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.card-main {
  position: relative;
  display: flex;
  padding: 24rpx;
}
.card-edit-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 1;
  padding: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eee;
  flex-shrink: 0;
}
.info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}
.price {
  color: #ee0a24;
  font-weight: bold;
  margin-right: 16rpx;
}
.card-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #fafafa;
}

.btn-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  transition: opacity 0.2s;
}
.btn-action:active {
  opacity: 0.8;
}

.btn-off {
  color: #666;
  background: #fff;
  border: 1rpx solid #e5e5e5;
}
.btn-off .van-icon {
  color: #969799;
}

.btn-del {
  color: #ee0a24;
  background: #fff;
  border: 1rpx solid #ffc4c4;
}
.btn-del .van-icon {
  color: #ee0a24;
}

.loading {
  padding: 40rpx;
}
