.page {
  padding: 20rpx;
  background: #f7f8fa;
  min-height: 100vh;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tip {
  flex: 1;
  font-size: 24rpx;
  color: #888;
  line-height: 1.4;
}

.create-btn {
  margin: 0;
  flex-shrink: 0;
  background: #1677ff;
  color: #fff;
  border-radius: 10rpx;
  font-size: 24rpx;
  line-height: 1.8;
  padding: 0 18rpx;
}

.card {
  background: #fff;
  border-radius: 14rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  min-width: 0;
}

.sort-pill {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #1677ff;
  background: #e8f3ff;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.desc {
  margin-top: 12rpx;
  color: #555;
  font-size: 26rpx;
  line-height: 1.5;
}

.desc.muted {
  color: #bbb;
}

.actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.action-btn {
  margin: 0;
  border-radius: 10rpx;
  background: #f2f3f5;
  color: #333;
}

.action-primary {
  background: #e8f3ff;
  color: #1677ff;
}

.action-danger {
  background: #fff1f0;
  color: #ff4d4f;
}

.empty,
.loading {
  margin-top: 80rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.modal {
  width: 680rpx;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.field {
  margin-bottom: 16rpx;
}

.label {
  color: #333;
  font-size: 26rpx;
  margin-bottom: 8rpx;
  display: block;
}

.input {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  background: #f8f8f8;
  border-radius: 10rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #333;
}

.input-placeholder {
  color: #bfbfbf;
}

.modal-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.form-btn {
  margin: 0;
  border-radius: 10rpx;
}

.form-btn-primary {
  background: #1677ff;
  color: #fff;
}
