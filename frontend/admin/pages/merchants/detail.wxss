/* admin/pages/merchants/detail.wxss */
.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.loading, .error {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #666;
}

.error {
  color: #ee0a24;
}

.detail {
  padding: 20rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 24rpx 24rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.basic-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar.placeholder {
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.basic-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.basic-info .name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx;
}

.thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
}

.idcard-row {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  flex-wrap: wrap;
}

.idcard-item {
  flex: 1;
  min-width: 280rpx;
}

.idcard-item .label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.idcard-img {
  width: 100%;
  border-radius: 8rpx;
  background: #f5f5f5;
  display: block;
}

.file-list {
  padding: 24rpx;
}

.file-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.file-item:last-child {
  margin-bottom: 0;
}

.file-url {
  font-size: 26rpx;
  color: #1989fa;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
