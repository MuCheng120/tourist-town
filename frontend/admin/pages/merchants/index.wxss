/* admin/pages/merchants/index.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.filter-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.filter-item {
  font-size: 28rpx;
  color: #333;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.merchant-list {
  padding: 0 20rpx;
}

.merchant-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar.placeholder {
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.head-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.contact, .phone {
  font-size: 24rpx;
  color: #666;
}

.tags {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-end;
}

.card-body {
  padding: 20rpx 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.row .label {
  color: #999;
}

.row .value {
  color: #333;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.loading-wrap, .no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal-box {
  width: 100%;
  max-width: 535rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.modal-btns {
  display: flex;
  justify-content: center;
  gap: 100rpx;  /* 加大按钮之间的间距 */
  margin-top: 24rpx;
}

/* 让弹窗底部两个按钮等宽排列，避免看起来“顶出弹窗” */
.modal-btns .van-button {
  flex: none;
  width: 220rpx;
}
