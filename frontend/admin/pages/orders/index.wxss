.orders-admin-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.filter-bar {
  background: #fff;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.search-row {
  margin-bottom: 16rpx;
}

.filter-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.filter-label-sp {
  margin-top: 16rpx;
}

.filter-item {
  font-size: 28rpx;
  color: #333;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.deleted-switch-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.deleted-switch-label {
  font-size: 26rpx;
  color: #666;
}

.stat-row {
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-text {
  font-weight: 500;
}

.risk-log-link {
  color: #ee0a24;
  font-size: 24rpx;
}

.order-list {
  padding: 0 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border-left: 6rpx solid #e8e8e8;
}

/* 按状态区分卡片左边框颜色，便于快速识别 */
.order-card.status-unpaid { border-left-color: #ee0a24; }
.order-card.status-paid { border-left-color: #ff976a; }
.order-card.status-shipped { border-left-color: #1989fa; }
.order-card.status-verified { border-left-color: #1989fa; }
.order-card.status-completed { border-left-color: #07c160; }
.order-card.status-cancelled { border-left-color: #969799; }
.order-card.status-refunding { border-left-color: #ff976a; }
.order-card.status-refunded { border-left-color: #969799; }

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.order-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.order-row .label {
  color: #999;
  width: 100rpx;
  flex-shrink: 0;
}

.order-row .value {
  color: #333;
  flex: 1;
}

.order-row .value.amount {
  color: #ff976a;
  font-weight: 600;
}

.order-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tap-hint {
  font-size: 24rpx;
  color: #1989fa;
}

.actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  margin: 0;
  line-height: 1.6;
  font-size: 22rpx;
  color: #fff;
  border: none;
  font-weight: 500;
}

.approve-btn,
.complete-hotel-btn {
  background: #07c160;
}

.reject-btn {
  background: #ee0a24;
}

.force-btn {
  background: #1989fa;
}

.tracking-btn {
  background: #7232dd;
}

.loading {
  padding: 40rpx;
  display: flex;
  justify-content: center;
}

.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #999;
}
