.scenic-admin-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx;
  background: white;
}

.search-input {
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: white;
  border-top: 1rpx solid #eee;
}

.stat-text {
  font-size: 26rpx;
  color: #666;
}

.btn-add {
  background: #1989fa;
  color: white;
  border: none;
}

/* 景点列表 */
.scenic-list {
  padding: 20rpx;
}

.scenic-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  gap: 20rpx;
}

.scenic-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

.scenic-cover image {
  width: 100%;
  height: 100%;
}

.scenic-status {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.scenic-status.active {
  background: rgba(7, 193, 96, 0.9);
  color: white;
}

.scenic-status.inactive {
  background: rgba(150, 150, 150, 0.9);
  color: white;
}

.scenic-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.scenic-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.scenic-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.id-badge {
  font-size: 22rpx;
  color: #666;
  background: #f2f3f5;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.scenic-details {
  margin-bottom: 16rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

.detail-label {
  color: #666;
  min-width: 140rpx;
}

.detail-value {
  color: #333;
  font-weight: bold;
}

.rating-count {
  color: #999;
  font-size: 22rpx;
  margin-left: 8rpx;
}

.scenic-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.tag {
  background: #e6f7ff;
  color: #1890ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.scenic-meta {
  margin-top: auto;
}

.meta-text {
  font-size: 22rpx;
  color: #999;
}

.scenic-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  justify-content: flex-start;
  align-items: center;
  padding-top: 4rpx;
}

.action-id-badge {
  margin-bottom: 0;
}

.btn-edit {
  background: #1989fa;
  color: white;
  border: none;
  width: 120rpx;
}

.btn-delete {
  background: #ff4d4f;
  color: white;
  border: none;
  width: 120rpx;
}

/* 加载状态 */
.loading-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #ccc;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-state image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
}

.empty-state text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-create {
  background: #1989fa;
  color: white;
  border: none;
  width: 300rpx;
}
