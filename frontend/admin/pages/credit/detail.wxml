<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:if="{{!loading && detail}}" class="card">
    <view class="title">商户信息</view>
    <view class="row">
      <text class="label">商户昵称</text>
      <text class="value">{{detail.merchant.nickname || '-'}}</text>
    </view>
    <view class="row">
      <text class="label">手机号</text>
      <text class="value">{{detail.merchant.phone || '-'}}</text>
    </view>
    <view class="row">
      <text class="label">信用等级</text>
      <text class="value">{{detail.credit_level || '-'}}</text>
    </view>
    <view class="row">
      <text class="label">信用分</text>
      <text class="value">{{detail.credit_score || 0}}</text>
    </view>
    <view class="row">
      <text class="label">当前状态</text>
      <text class="value">{{statusTextMap[detail.status] || detail.status || '-'}}</text>
    </view>
    <view class="row">
      <text class="label">订单完成率</text>
      <text class="value">{{detail.order_completion_rate || 0}}%</text>
    </view>
    <view class="row">
      <text class="label">准时率</text>
      <text class="value">{{detail.on_time_rate || 0}}%</text>
    </view>
    <view class="row">
      <text class="label">差评率</text>
      <text class="value">{{detail.bad_review_rate || 0}}%</text>
    </view>
  </view>

  <view wx:if="{{!loading}}" class="card">
    <view class="title">违规记录</view>
    <view class="row">
      <text class="label">处理备注</text>
      <input
        class="remark-input"
        value="{{resolveRemark}}"
        placeholder="可填写解除说明，便于追溯"
        bindinput="onResolveRemarkChange"
      />
    </view>
    <view wx:if="{{violations.length === 0}}" class="sub-empty">
      <text>暂无违规记录</text>
    </view>
    <view wx:for="{{violations}}" wx:key="id" class="violation-item">
      <view class="row">
        <text class="label">类型</text>
        <text class="value">{{item.typeText}}</text>
      </view>
      <view class="row">
        <text class="label">原因</text>
        <text class="value">{{item.reason || '-'}}</text>
      </view>
      <view class="row">
        <text class="label">状态</text>
        <view class="status-badge {{item.status === 'resolved' ? 'status-resolved' : 'status-active'}}">
          <text>{{item.status === 'resolved' ? '已解除' : '生效中'}}</text>
        </view>
      </view>
      <view class="row">
        <text class="label">时间</text>
        <text class="value">{{item.timeText}}</text>
      </view>
      <view class="timeline">
        <view class="timeline-dot active"></view>
        <view class="timeline-content">
          <text class="timeline-title">处罚生效</text>
          <text class="timeline-time">{{item.timeText}}</text>
        </view>
      </view>
      <view class="timeline" wx:if="{{item.status === 'resolved'}}">
        <view class="timeline-dot resolved"></view>
        <view class="timeline-content">
          <text class="timeline-title">处罚解除</text>
          <text class="timeline-time">{{item.resolvedTimeText}}</text>
        </view>
      </view>
      <view class="actions">
        <button
          class="action-btn {{item.status === 'resolved' ? 'action-disabled' : 'action-primary'}}"
          size="mini"
          disabled="{{item.status === 'resolved' || resolvingId === item.id}}"
          bindtap="resolveViolation"
          data-id="{{item.id}}"
          data-status="{{item.status}}"
        >
          {{item.status === 'resolved' ? '已解除' : '解除处罚'}}
        </button>
      </view>
    </view>
  </view>
</view>