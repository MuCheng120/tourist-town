/* 管理端记录商户违规页面样式 */
.violate-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 商户信息 */
.merchant-info {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  color: #fff;
}

.info-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 12rpx;
}

.info-value {
  font-size: 36rpx;
  font-weight: bold;
}

/* 表单区域 */
.form-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.label.required::before {
  content: '*';
  color: #ff4d4f;
  margin-right: 8rpx;
}

/* 选择器 */
.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  height: 88rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.picker-text {
  flex: 1;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.picker-text.placeholder {
  color: #999;
}

.picker-value .arrow {
  margin-left: 16rpx;
  line-height: 1;
  font-size: 20rpx;
  color: #999;
}

/* 类型提示 */
.type-tips {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.tip-item {
  font-size: 26rpx;
  color: #fa8c16;
  line-height: 1.6;
}

/* 文本域 */
.textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 注意事项 */
.notice {
  background: #f0f5ff;
  border: 1rpx solid #adc6ff;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-top: 40rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 16rpx;
}

.notice-list {
  padding-left: 10rpx;
}

.notice-item {
  font-size: 26rpx;
  color: #597ef7;
  line-height: 1.8;
}

/* 操作按钮 */
.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.btn::after {
  border: none;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.submit-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.submit-btn[disabled] {
  opacity: 0.6;
}
