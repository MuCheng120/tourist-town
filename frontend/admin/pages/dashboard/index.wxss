/* admin/pages/dashboard/index.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 数据统计 */
.stats-section {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.stat-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.2);
}

.stat-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  margin-right: 20rpx;
}

.stat-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 今日数据 */
.today-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

.today-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.today-item {
  padding: 24rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.today-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.today-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.today-value.amount {
  color: #ee0a24;
}

/* 审核中心 */
.audit-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.view-all {
  font-size: 26rpx;
  color: #07c160;
}

.audit-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.audit-item {
  padding: 30rpx 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.audit-label {
  font-size: 26rpx;
  color: #333;
  margin: 16rpx 0;
}

/* 咨询电话设置 */
.settings-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.contact-phone-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.contact-phone-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.contact-phone-save {
  flex-shrink: 0;
}

.settings-tip {
  font-size: 24rpx;
  color: #999;
}

/* 快捷操作 */
.actions-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.action-list {
  display: flex;
  flex-direction: column;
}

.action-group {
  margin-bottom: 20rpx;
}

.action-group:last-child {
  margin-bottom: 0;
}

.action-group-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
  display: block;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  min-height: 86rpx;
  box-sizing: border-box;
}

.action-item text {
  margin-left: 0;
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.action-item--empty {
  background: transparent;
}

/* 系统通知 */
.notice-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.notice-list {
  display: flex;
  flex-direction: column;
}

.notice-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff3e0;
  border-radius: 50%;
  margin-right: 16rpx;
}

.notice-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.notice-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.notice-time {
  font-size: 22rpx;
  color: #999;
}

/* 退出登录 */
.logout-section {
  margin: 40rpx 20rpx;
}

.logout-btn {
  background: #fff;
  color: #ee0a24;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 30rpx;
}

.logout-btn::after {
  border: none;
}
