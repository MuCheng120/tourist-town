/* admin/pages/hotel/room-types.wxss - 与 index 共用样式结构 */
.container { padding: 20rpx; }
.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; }
.page-title { font-size: 36rpx; font-weight: bold; }
.btn-primary { background-color: #1890ff; color: white; border: none; border-radius: 8rpx; padding: 16rpx 32rpx; font-size: 28rpx; }
.risk-log-bar { margin-bottom: 16rpx; }
.risk-log-text { color: #ee0a24; font-size: 24rpx; }

.room-list { display: flex; flex-direction: column; gap: 20rpx; }
.room-item { background-color: white; border-radius: 12rpx; padding: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1); }
.room-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.room-name { font-size: 32rpx; font-weight: bold; }
.status-tag { padding: 8rpx 16rpx; border-radius: 4rpx; font-size: 24rpx; }
.status-tag.active { background-color: #52c41a; color: white; }
.status-tag.inactive { background-color: #d9d9d9; color: #666; }
.room-info { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 16rpx; }
.room-info-row { flex-direction: row; align-items: baseline; flex-wrap: wrap; gap: 16rpx 24rpx; }
.room-price { font-size: 36rpx; color: #ff4d4f; font-weight: bold; }
.room-stock-today { font-size: 28rpx; color: #666; }
.room-images { display: flex; gap: 16rpx; margin-bottom: 16rpx; overflow-x: auto; }
.room-image { width: 200rpx; height: 150rpx; border-radius: 8rpx; flex-shrink: 0; }
.room-actions { display: flex; gap: 16rpx; flex-wrap: wrap; }
.btn-small { padding: 12rpx 24rpx; border-radius: 6rpx; font-size: 26rpx; border: none; }
.btn-info { background-color: #1890ff; color: white; }
.btn-warning { background-color: #faad14; color: white; }
.btn-success { background-color: #52c41a; color: white; }
.btn-danger { background-color: #ff4d4f; color: white; }
.empty { text-align: center; padding: 100rpx 0; color: #999; font-size: 28rpx; }
.loading { text-align: center; padding: 40rpx 0; color: #999; }

.modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000; }
.modal-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.5); }
.modal-content { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90%; max-height: 80vh; background-color: white; border-radius: 16rpx; overflow: hidden; display: flex; flex-direction: column; }
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 32rpx; border-bottom: 1rpx solid #f0f0f0; }
.modal-title { font-size: 32rpx; font-weight: bold; }
.modal-close { font-size: 48rpx; color: #999; }
.modal-body { padding: 32rpx; overflow-y: auto; }
.modal-footer { display: flex; justify-content: flex-end; gap: 16rpx; padding: 24rpx 32rpx; border-top: 1rpx solid #f0f0f0; }
.btn-cancel { background-color: #f5f5f5; color: #666; border: none; border-radius: 8rpx; padding: 16rpx 32rpx; font-size: 28rpx; }
.btn-confirm { background-color: #1890ff; color: white; border: none; border-radius: 8rpx; padding: 16rpx 32rpx; font-size: 28rpx; }

.form-item { margin-bottom: 24rpx; width: 100%; min-width: 0; box-sizing: border-box; }
.form-label { display: block; margin-bottom: 12rpx; font-size: 28rpx; color: #333; }
.form-input {
  display: block;
  width: 100%;
  min-height: 72rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.form-textarea { width: 100%; padding: 16rpx; border: 1rpx solid #d9d9d9; border-radius: 8rpx; font-size: 28rpx; min-height: 120rpx; box-sizing: border-box; }
.form-hint { display: block; margin-top: 8rpx; font-size: 24rpx; color: #999; }
.picker-view { padding: 16rpx; border: 1rpx solid #d9d9d9; border-radius: 8rpx; font-size: 28rpx; }

.image-list { display: flex; gap: 16rpx; flex-wrap: wrap; }
.image-item { position: relative; width: 160rpx; height: 160rpx; }
.image-preview { width: 100%; height: 100%; border-radius: 8rpx; object-fit: cover; }
.image-delete { position: absolute; top: -10rpx; right: -10rpx; width: 40rpx; height: 40rpx; background-color: rgba(0, 0, 0, 0.5); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 32rpx; line-height: 1; }
.image-add { width: 160rpx; height: 160rpx; border: 2rpx dashed #d9d9d9; border-radius: 8rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: #999; }
.add-icon { font-size: 48rpx; line-height: 1; }
.add-text { font-size: 24rpx; }
