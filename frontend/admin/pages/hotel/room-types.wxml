    </view>
  </view>
</view>

<!-- 库存弹窗 -->
<view class="modal" wx:if="{{showStockModal}}">
  <view class="modal-mask" bindtap="closeStockDialog"></view>
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">库存管理</text>
      <text class="modal-close" bindtap="closeStockDialog">×</text>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">开始日期</text>
        <picker mode="date" value="{{dateRange.start}}" bindchange="onStartDateChange">
          <view class="picker-view">{{dateRange.start}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">结束日期</text>
        <picker mode="date" value="{{dateRange.end}}" bindchange="onEndDateChange">
          <view class="picker-view">{{dateRange.end}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-hint">设置范围内每天库存（将覆盖原值）</text>
        <input
          class="form-input"
          type="number"
          value="{{stockCount}}"
          bindinput="onStockCountChange"
          placeholder="请输入每日库存"
        />
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn-cancel" bindtap="closeStockDialog">取消</button>
      <button class="btn-confirm" bindtap="setStock">确定</button>
    </view>
  </view>
</view>
