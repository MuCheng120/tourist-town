.analysis-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.overview-cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.card {
  min-width: 0;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
}

.card-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.card-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-value.main {
  color: #07c160;
  font-size: 34rpx;
}

.report-range {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.page-loading {
  padding: 80rpx 0;
  display: flex;
  justify-content: center;
}

.chart-section {
  padding: 24rpx;
}

.chart-wrap {
  width: 100%;
  height: 420rpx;
}

.chart-wrap-pie {
  height: 480rpx;
}

.chart-wrap-bar-side {
  height: 520rpx;
}

.subsection-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #444;
  margin: 8rpx 0 12rpx;
  padding-top: 8rpx;
}

.behavior-hint,
.analysis-scope-hint {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.behavior-page-table {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.behavior-table-head,
.behavior-table-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.behavior-table-head {
  font-weight: 600;
  color: #666;
  font-size: 22rpx;
  border-bottom: 2rpx solid #eee;
}

.col-page-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 12rpx;
}

.col-page-num {
  flex: 0 0 72rpx;
  text-align: center;
  font-size: 20rpx;
}

.col-page-stay {
  flex: 0 0 88rpx;
  text-align: right;
  font-size: 20rpx;
}

.chart-wrap ec-canvas {
  width: 100%;
  height: 100%;
}

.ec-canvas {
  width: 100%;
  height: 100%;
}

/* 商户明细表 */
.table-head,
.table-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.table-head {
  font-weight: 600;
  color: #666;
  border-bottom: 2rpx solid #eee;
}

.col-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col-num {
  width: 100rpx;
  text-align: center;
}

.col-amount {
  width: 140rpx;
  text-align: right;
  color: #07c160;
}

.col-rate {
  width: 100rpx;
  text-align: right;
  color: #1989fa;
}

.ranking-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.ranking-index {
  width: 56rpx;
  color: #999;
  font-size: 24rpx;
}

.ranking-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.ranking-value {
  font-size: 26rpx;
  color: #07c160;
  font-weight: 600;
}
