.container {
  padding: 24rpx;
}
.filter-bar {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.filter-item {
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.user-list {
  padding: 0;
}
.user-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.card-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}
.card-row .label {
  color: #999;
  margin-right: 12rpx;
  min-width: 120rpx;
}
.card-row .value {
  flex: 1;
}
.card-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}
.loading {
  text-align: center;
  padding: 40rpx;
}
