<!--管理员 - 优惠券管理-->
<view class="coupon-container">
  <!-- 标签栏 -->
  <view class="tabs">
    <view 
      class="tab-item {{activeTab === index ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="index"
      bindtap="onTabChange"
      data-index="{{index}}"
    >
      {{item}}
    </view>
  </view>

  <!-- 操作栏 -->
  <view class="action-bar">
    <button class="create-btn" bindtap="showCreateModal">创建优惠券</button>
  </view>

  <!-- 优惠券列表 -->
  <view class="coupon-list">
    <view class="coupon-item" wx:for="{{couponList}}" wx:key="id">
      <view class="coupon-header">
        <view class="coupon-title">{{item.title}}</view>
        <view class="coupon-status {{item.effectiveStatus === 1 ? 'active' : 'inactive'}}">
          {{item.effectiveStatus === 1 ? '生效中' : (item.isExpired ? '已过期' : '已失效')}}
        </view>
      </view>

      <view class="coupon-info">
        <view class="info-row">
          <text class="label">类型：</text>
          <text class="value">平台券</text>
        </view>
        <view class="info-row">
          <text class="label">优惠：</text>
          <text class="value highlight">¥{{item.value}}</text>
          <text class="label" wx:if="{{item.min_spend > 0}}">，满¥{{item.min_spend}}可用</text>
        </view>
        <view class="info-row">
          <text class="label">发行：</text>
          <text class="value">{{item.received_count}}/{{item.total_count}}</text>
          <text class="label">，已使用：</text>
          <text class="value">{{item.used_count}}</text>
        </view>
        <view class="info-row">
          <text class="label">有效期至：</text>
          <text class="value">{{item.expiry_date_display || item.expiry_date}}</text>
        </view>
      </view>

      <view class="coupon-actions">
        <button 
          class="action-btn" 
          size="mini"
          bindtap="viewDetail"
          data-id="{{item.id}}"
        >
          查看详情
        </button>
        <button
          wx:if="{{!item.isExpired}}"
          class="action-btn {{item.effectiveStatus === 1 ? 'warning' : 'success'}}"
          size="mini"
          bindtap="updateStatus"
          data-id="{{item.id}}"
          data-status="{{item.effectiveStatus === 1 ? 0 : 1}}"
        >
          {{item.effectiveStatus === 1 ? '禁用' : '启用'}}
        </button>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{couponList.length === 0 && !loading}}">
      <van-empty description="暂无优惠券" />
    </view>

    <!-- 加载中 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>

  <!-- 创建优惠券弹窗 -->
  <view class="modal-mask" wx:if="{{showCreateDialog}}" bindtap="hideCreateModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">创建优惠券</text>
        <text class="modal-close" bindtap="hideCreateModal">×</text>
      </view>

      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">优惠券标题</text>
          <input 
            class="form-input" 
            placeholder="请输入优惠券标题"
            placeholder-class="input-placeholder"
            value="{{formData.title}}"
            bindinput="onInputChange"
            data-field="title"
          />
        </view>

        <view class="form-item">
          <text class="form-label">优惠金额（元）</text>
          <input 
            class="form-input" 
            type="digit"
            placeholder="请输入优惠金额"
            placeholder-class="input-placeholder"
            value="{{formData.value}}"
            bindinput="onInputChange"
            data-field="value"
          />
        </view>

        <view class="form-item">
          <text class="form-label">最低消费（元）</text>
          <input 
            class="form-input" 
            type="digit"
            placeholder="0表示无门槛"
            placeholder-class="input-placeholder"
            value="{{formData.min_spend}}"
            bindinput="onInputChange"
            data-field="min_spend"
          />
        </view>

        <view class="form-item">
          <text class="form-label">发行数量</text>
          <input 
            class="form-input" 
            type="number"
            placeholder="请输入发行数量"
            placeholder-class="input-placeholder"
            value="{{formData.total_count}}"
            bindinput="onInputChange"
            data-field="total_count"
          />
        </view>

        <view class="form-item">
          <text class="form-label">过期日期</text>
          <picker 
            mode="date" 
            value="{{formData.expiry_date}}"
            bindchange="onDateChange"
          >
            <view class="picker">
              {{formData.expiry_date || '请选择过期日期'}}
            </view>
          </picker>
        </view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="hideCreateModal">取消</button>
        <button class="modal-btn confirm" bindtap="createCoupon">确定</button>
      </view>
    </view>
  </view>
</view>
