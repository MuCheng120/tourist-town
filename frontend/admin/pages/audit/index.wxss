/* admin/pages/audit/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 审核列表 */
.audit-list {
  padding: 20rpx;
}

.risk-log-bar {
  padding: 12rpx 24rpx;
}

.risk-log-text {
  color: #ee0a24;
  font-size: 24rpx;
}

.audit-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.merchant-info, .comment-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.info {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.post-info {
  flex: 1;
}

.title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

/* 卡片内容 */
.card-body {
  padding: 20rpx 0;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-row .label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.info-row .value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
}

.content-preview {
  display: flex;
  flex-direction: column;
  padding: 16rpx;
  background-color: #f7f8fa;
  border-radius: 8rpx;
}

.content-preview .label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.content-preview .value {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  margin-left: 16rpx;
  border-radius: 40rpx;
}

.detail-btn {
  background-color: #fff;
  border-color: #ddd;
  color: #666;
}

.reject-btn {
  background-color: #fff;
  border-color: #ff6034;
  color: #ff6034;
}

.approve-btn {
  background-color: #1989fa;
  border-color: #1989fa;
  color: #fff;
}

/* 提交材料详情 */
.detail-section {
  margin-top: 16rpx;
}

.detail-section .label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-list .thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
}

/* 身份证正反面 */
.idcard-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 12rpx;
}
.idcard-item {
  flex: 0 0 auto;
}
.idcard-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.idcard-thumb {
  width: 240rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  display: block;
}

/* 资质文件列表（图片+文件行） */
.qualification-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}
.qualification-list .thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
}
.file-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
}
.file-text {
  font-size: 26rpx;
  color: #1989fa;
}

/* 拒绝审核意见弹层 */
.reject-popup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.reject-popup {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.reject-popup-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 24rpx;
}

.reject-opinion-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.reject-popup-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.template-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.template-item {
  font-size: 24rpx;
  color: #1989fa;
  background: #eef6ff;
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
}

.reject-popup-btn {
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.reject-popup-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.reject-popup-btn.confirm {
  background: #1989fa;
  color: #fff;
}
