# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tourist_town
DB_USERNAME=your_username
DB_PASSWORD=your_password

# JWT配置（生产环境请使用强随机值并妥善保管）
JWT_SECRET=dev_only_jwt_secret

# 服务器配置
SERVER_PORT=7001

# 微信小程序配置（以下为示例占位，正式环境请替换）
WECHAT_APP_ID=your_wechat_appid
WECHAT_APP_SECRET=your_wechat_appsecret

